<Window x:Class="TotalWarModTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:TotalWarModTool.App.Shell"
        Title="{Binding Texts.AppTitle}"
        Width="1200" Height="800" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.Text}">
    <!-- Bound on the window, not on a view: the shortcuts work wherever the focus is. -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding Tabs.CloseSelectedCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Documents.UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding Documents.RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Documents.SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding Documents.SaveAllCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding Projects.BuildActiveCommand}" />
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding Projects.BuildAndInstallActiveCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <!-- The mod projects; only when the app has projects. A disabled entry says why in its tool tip. -->
            <MenuItem Header="{Binding Texts.ProjectMessageTitle}" Visibility="{Binding HasProjects, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="{Binding Texts.ProjectNewTitle}" Command="{Binding Projects.NewProjectCommand}"
                          ToolTip="{Binding Projects.ProjectsDisabledReason}" ToolTipService.ShowOnDisabled="True" />
                <MenuItem Header="{Binding Texts.MenuProjectOpen}" Command="{Binding Projects.OpenProjectCommand}"
                          ToolTip="{Binding Projects.ProjectsDisabledReason}" ToolTipService.ShowOnDisabled="True" />
                <MenuItem Header="{Binding Texts.MenuProjectImport}" Command="{Binding Projects.ImportPackCommand}"
                          ToolTip="{Binding ProjectImportToolTip}" ToolTipService.ShowOnDisabled="True" />
                <Separator />
                <!-- New files for the active project; only when the app has the file operations. Their separator goes with them. -->
                <MenuItem Header="{Binding Texts.FileNewTableTitle}" Command="{Binding NewTableCommand}"
                          Visibility="{Binding HasProjectFiles, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="{Binding ProjectNewTableToolTip}" ToolTipService.ShowOnDisabled="True" />
                <MenuItem Header="{Binding Texts.FileNewLocTitle}" Command="{Binding NewLocCommand}"
                          Visibility="{Binding HasProjectFiles, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="{Binding ProjectNewFileToolTip}" ToolTipService.ShowOnDisabled="True" />
                <Separator Visibility="{Binding HasProjectFiles, Converter={StaticResource BoolToVisibility}}" />
                <!-- Saving needs the editable documents. Nothing to save needs no explanation; only a running operation gets a tool tip. -->
                <MenuItem Header="{Binding Texts.MenuProjectSave}" Command="{Binding Documents.SaveCommand}"
                          Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibility}}"
                          InputGestureText="{Binding Texts.MenuProjectSaveGesture}"
                          ToolTip="{Binding ProjectSaveToolTip}" ToolTipService.ShowOnDisabled="True" />
                <MenuItem Header="{Binding Texts.MenuProjectSaveAll}" Command="{Binding Documents.SaveAllCommand}"
                          Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibility}}"
                          InputGestureText="{Binding Texts.MenuProjectSaveAllGesture}"
                          ToolTip="{Binding ProjectSaveToolTip}" ToolTipService.ShowOnDisabled="True" />
                <Separator Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="{Binding Texts.BuildMessageTitle}" Command="{Binding Projects.BuildActiveCommand}"
                          InputGestureText="{Binding Texts.MenuProjectBuildGesture}"
                          ToolTip="{Binding ProjectBuildToolTip}" ToolTipService.ShowOnDisabled="True" />
                <MenuItem Header="{Binding Texts.ProjectActionBuildAndInstall}" Command="{Binding Projects.BuildAndInstallActiveCommand}"
                          InputGestureText="{Binding Texts.MenuProjectBuildAndInstallGesture}"
                          ToolTip="{Binding ProjectBuildAndInstallToolTip}" ToolTipService.ShowOnDisabled="True" />
            </MenuItem>
            <!-- Undo and redo across the editable tabs; only when the app has documents. A text box with the focus keeps its own Ctrl+Z. -->
            <MenuItem Header="{Binding Texts.MenuEdit}" Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="{Binding Texts.MenuEditUndo}" Command="{Binding Documents.UndoCommand}"
                          InputGestureText="{Binding Texts.MenuEditUndoGesture}" />
                <MenuItem Header="{Binding Texts.MenuEditRedo}" Command="{Binding Documents.RedoCommand}"
                          InputGestureText="{Binding Texts.MenuEditRedoGesture}" />
            </MenuItem>
            <!-- Opens the settings window directly; no submenu. -->
            <MenuItem Header="{Binding Texts.MenuSettings}" Command="{Binding OpenSettingsCommand}" />
            <MenuItem Header="{Binding Texts.MenuHelp}">
                <MenuItem Header="{Binding Texts.MenuOpenLogFolder}" Command="{Binding OpenLogFolderCommand}" />
            </MenuItem>
            <!-- Only in the debug build: IsDebugBuild is false in a release build, so the menu is collapsed there. -->
            <MenuItem Header="{Binding Texts.MenuDebug}" Visibility="{Binding IsDebugBuild, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="{Binding Texts.MenuDebugThrow}" Command="{Binding DebugThrowCommand}" />
                <MenuItem Header="{Binding Texts.MenuDebugSlow}" Command="{Binding DebugSlowCommand}" />
                <MenuItem Header="{Binding Texts.MenuDebugFail}" Command="{Binding DebugFailCommand}" />
            </MenuItem>
        </Menu>

        <!-- The wizards as tiles. The code-behind binds it to the settings and the wizards (MainWindow.Shell.cs). -->
        <shell:TileBar x:Name="TileBarControl" DockPanel.Dock="Top" />

        <!-- Game, schema and the first hint. The hint is in the colour of a warning and hidden when there is none. -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusGame}" ToolTip="{Binding StatusGameToolTip}" />
            </StatusBarItem>
            <StatusBarItem Padding="0">
                <Border Width="1" Height="14" Margin="2,0" Background="{DynamicResource Theme.Separator}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusSchema}" />
            </StatusBarItem>
            <StatusBarItem x:Name="StatusHintItem" Visibility="{Binding HasStatusHint, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusHint}" Foreground="{DynamicResource Theme.Warning}" />
            </StatusBarItem>
            <!-- The result of the last project command: its first line, the whole text as the tool tip. Hidden when there is none. -->
            <StatusBarItem x:Name="ProjectStatusItem" Visibility="{Binding HasProjectStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ProjectStatusLine}" ToolTip="{Binding ProjectStatusToolTip}" />
            </StatusBarItem>
        </StatusBar>

        <!--
            The small toolbar, built in code from the toolbar catalog and the settings (MainWindow.Shell.cs). It stands after the status bar, so at
            the left, the right or the bottom it sits between the tile bar and the status bar; the code-behind sets its dock and its border.
        -->
        <Border x:Name="ToolbarHost" Background="{DynamicResource Theme.WindowBackground}" BorderBrush="{DynamicResource Theme.Separator}" />

        <!-- Explorer, splitter, tabs. The views need their view models, so the code-behind creates them and puts them into the hosts. -->
        <Grid x:Name="Layout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="150" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="150" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="ExplorerHost" Grid.Column="0" IsTabStop="False" />
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
            <ContentControl x:Name="TabsHost" Grid.Column="2" IsTabStop="False" />
        </Grid>
    </DockPanel>
</Window>
