<Window x:Class="TotalWarModTool.App.CrashDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding CrashTitle}"
        Width="680" Height="440" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.Text}">
    <!-- DataContext is the AppTexts instance; the details text is set in code because it is the report, not a UI text. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageBlock" Text="{Binding CrashMessage}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBox x:Name="DetailsBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenLogButton" Content="{Binding CrashOpenLog}" MinWidth="90" Padding="12,3" Click="OnOpenLogClick" />
            <Button x:Name="CopyDetailsButton" Content="{Binding CrashCopyDetails}" MinWidth="90" Padding="12,3" Margin="8,0,0,0" Click="OnCopyDetailsClick" />
            <Button x:Name="CloseButton" Content="{Binding CrashClose}" MinWidth="90" Padding="12,3" Margin="8,0,0,0" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
