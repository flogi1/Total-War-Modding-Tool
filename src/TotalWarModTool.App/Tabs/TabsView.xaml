<UserControl x:Class="TotalWarModTool.App.TabsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TotalWarModTool.App">
    <!--
        DataContext is the TabsViewModel. The content of a tab comes from the data template of its view model type. The texts of the view
        (tooltips, column headers) are read through TabsViewModel.Texts, so they follow a change of the language.
    -->
    <UserControl.InputBindings>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseSelectedCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            The switch between grid and text of a table or loc tab: two toggle-styled radio buttons of one group. The grid button follows
            ShowGrid, a click on it makes the group uncheck the text button, which writes ShowText = false. DataContext is the tab.
            The toggle style is looked up dynamically like the colours, so that it is the themed one of the window the view is in.
        -->
        <DataTemplate x:Key="ViewSwitch">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{DynamicResource {x:Type ToggleButton}}" IsChecked="{Binding ShowGrid, Mode=OneWay}"
                             Content="{Binding DataContext.Texts.TabViewGrid, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}" />
                <RadioButton Style="{DynamicResource {x:Type ToggleButton}}" IsChecked="{Binding ShowText}" Margin="-1,0,0,0"
                             Content="{Binding DataContext.Texts.TabViewText, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}" />
            </StackPanel>
        </DataTemplate>

        <!--
            The line of a project tab whose file was changed or deleted outside: what happened (the same text as the tool tip of the mark) and the
            button that reads the file again. The button shows only while the tab has no changes of its own (CanReload). DataContext is the tab.
        -->
        <DataTemplate x:Key="OutsideChangeBar">
            <DockPanel Margin="6,2,6,4" LastChildFill="True">
                <Button x:Name="ReloadButton" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,2" VerticalAlignment="Center"
                        Command="{Binding ReloadCommand}"
                        Content="{Binding DataContext.Texts.TabReload, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}"
                        Visibility="{Binding CanReload, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StaleText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Warning}" />
            </DockPanel>
        </DataTemplate>

        <!--
            A line of text under the header that shows only while the bound text is not null, in the colour of a warning: the message of a
            cell with an invalid value, and what the last copy or paste has to say. The Margin differs from the one of the text notice on purpose.
        -->
        <Style x:Key="GridMessageLine" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,6,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Warning}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            An editable table or loc file of a project: the line of an outside change, the header with the switch to the text view, the message
            of a cell with an invalid value, the notice of the last copy or paste, then the editable grid (or the text). The context menu holds
            the row commands of the view model; its texts come from the texts of the tab, because a menu is not in the visual tree of the view.
        -->
        <DataTemplate DataType="{x:Type local:EditableRowsTabViewModel}">
            <DockPanel>
                <ContentPresenter x:Name="OutsideChange" DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource OutsideChangeBar}"
                                  Visibility="{Binding IsStaleOutside, Converter={StaticResource BoolToVisibility}}" />
                <DockPanel DockPanel.Dock="Top">
                    <ContentPresenter DockPanel.Dock="Right" Margin="6,2" Content="{Binding}" ContentTemplate="{StaticResource ViewSwitch}" />
                    <TextBlock Text="{Binding Header}" Margin="6,4" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="ValidationLine" DockPanel.Dock="Top" Text="{Binding ValidationMessage}" Style="{StaticResource GridMessageLine}" />
                <TextBlock x:Name="NoticeLine" DockPanel.Dock="Top" Text="{Binding Notice}" Style="{StaticResource GridMessageLine}" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding TextNotice}" Margin="6,0,6,4" TextWrapping="Wrap"
                           Foreground="{DynamicResource Theme.Warning}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TextNotice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowText}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid>
                    <local:TableGrid EditColumns="{Binding Columns}" ItemsSource="{Binding Rows}"
                                     Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibility}}">
                        <local:TableGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding Texts.GridInsertRow}" Command="{Binding InsertRowCommand}" />
                                <MenuItem Header="{Binding Texts.GridDuplicateRows}" Command="{Binding DuplicateRowsCommand}" />
                                <MenuItem Header="{Binding Texts.GridDeleteRows}" Command="{Binding DeleteRowsCommand}" />
                                <Separator />
                                <MenuItem Header="{Binding Texts.GridCopy}" Command="{Binding CopyRowsCommand}" />
                                <MenuItem Header="{Binding Texts.GridPaste}" Command="{Binding PasteRowsCommand}" />
                                <Separator />
                                <MenuItem Header="{Binding Texts.GridShowObject}" Command="{Binding ShowObjectCommand}" ToolTip="{Binding ShowObjectReason}"
                                          ToolTipService.ShowOnDisabled="True" />
                            </ContextMenu>
                        </local:TableGrid.ContextMenu>
                    </local:TableGrid>
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
        </DataTemplate>

        <!-- A table: the line above the grid with the switch beside it, the notice (only in the text view), then the grid or the text. The grid builds its columns from the names. -->
        <DataTemplate DataType="{x:Type local:TableTabViewModel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <ContentPresenter DockPanel.Dock="Right" Margin="6,2" Content="{Binding}" ContentTemplate="{StaticResource ViewSwitch}" />
                    <TextBlock Text="{Binding Header}" Margin="6,4" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding TextNotice}" Margin="6,0,6,4" TextWrapping="Wrap"
                           Foreground="{DynamicResource Theme.Warning}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TextNotice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowText}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}" Style="{StaticResource GridMessageLine}" />
                <Grid>
                    <local:TableGrid ColumnNames="{Binding Columns}" ItemsSource="{Binding Rows}"
                                     Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibility}}">
                        <local:TableGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding Texts.GridCopy}" Command="{Binding CopyRowsCommand}" />
                                <Separator />
                                <MenuItem Header="{Binding Texts.GridShowObject}" Command="{Binding ShowObjectCommand}" ToolTip="{Binding ShowObjectReason}"
                                          ToolTipService.ShowOnDisabled="True" />
                            </ContextMenu>
                        </local:TableGrid.ContextMenu>
                    </local:TableGrid>
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
        </DataTemplate>

        <!-- A loc file: three fixed columns, or the text. The headers are elements so that they can read the texts of the view. -->
        <DataTemplate DataType="{x:Type local:LocTabViewModel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <ContentPresenter DockPanel.Dock="Right" Margin="6,2" Content="{Binding}" ContentTemplate="{StaticResource ViewSwitch}" />
                    <TextBlock Text="{Binding Header}" Margin="6,4" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding TextNotice}" Margin="6,0,6,4" TextWrapping="Wrap"
                           Foreground="{DynamicResource Theme.Warning}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TextNotice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowText}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}" Style="{StaticResource GridMessageLine}" />
                <Grid>
                    <local:TableGrid ItemsSource="{Binding Rows}"
                                     Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibility}}">
                        <local:TableGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding Texts.GridCopy}" Command="{Binding CopyRowsCommand}" />
                            </ContextMenu>
                        </local:TableGrid.ContextMenu>
                        <local:TableGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Key, Mode=OneWay}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{Binding DataContext.Texts.TabLocKey, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Text, Mode=OneWay}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{Binding DataContext.Texts.TabLocText, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Binding="{Binding Tooltip, Mode=OneWay}" IsReadOnly="True">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="{Binding DataContext.Texts.TabLocTooltip, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}" />
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                        </local:TableGrid.Columns>
                    </local:TableGrid>
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
        </DataTemplate>

        <!--
            An object: the buttons of the history, refresh, the jump to the row, apply and "copy as", then the status (its tool tip lists the warnings); under
            it the result line of the last apply, the notice and, while the tab is outdated, what changed with a refresh button; then the editor
            with the block text. Alt+Left and Alt+Right move through the history, Ctrl+Enter applies, while the focus is in the tab.
        -->
        <DataTemplate DataType="{x:Type local:ObjectTabViewModel}">
            <DockPanel>
                <DockPanel.InputBindings>
                    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
                    <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardCommand}" />
                    <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding ApplyCommand}" />
                </DockPanel.InputBindings>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2">
                    <Button Command="{Binding BackCommand}" Padding="8,2"
                            Content="{Binding DataContext.Texts.ObjectsBack, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}"
                            ToolTip="{Binding DataContext.Texts.ObjectsBack, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}" />
                    <Button Command="{Binding ForwardCommand}" Padding="8,2" Margin="4,0,0,0"
                            Content="{Binding DataContext.Texts.ObjectsForward, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}"
                            ToolTip="{Binding DataContext.Texts.ObjectsForward, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}" />
                    <Button Command="{Binding RefreshCommand}" Padding="8,2" Margin="4,0,0,0"
                            Content="{Binding DataContext.Texts.ObjectsRefresh, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}"
                            ToolTip="{Binding DataContext.Texts.ObjectsRefresh, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}" />
                    <Button Command="{Binding JumpToRowCommand}" Padding="8,2" Margin="4,0,0,0"
                            Content="{Binding DataContext.Texts.ObjectsJumpToRow, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}"
                            ToolTip="{Binding DataContext.Texts.ObjectsJumpToRow, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}" />
                    <Button Command="{Binding ApplyCommand}" Padding="8,2" Margin="4,0,0,0" ToolTipService.ShowOnDisabled="True"
                            Content="{Binding DataContext.Texts.ObjectsApply, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}"
                            ToolTip="{Binding ApplyToolTip}" />
                    <Button Command="{Binding CopyCommand}" Padding="8,2" Margin="4,0,0,0" ToolTipService.ShowOnDisabled="True"
                            Content="{Binding DataContext.Texts.ObjectsCopyAs, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}"
                            ToolTip="{Binding CopyToolTip}" />
                    <TextBlock Text="{Binding Status}" ToolTip="{Binding WarningsText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ResultLine" DockPanel.Dock="Top" Text="{Binding ResultLine}" Style="{StaticResource GridMessageLine}" />
                <TextBlock x:Name="NoticeLine" DockPanel.Dock="Top" Text="{Binding Notice}" Style="{StaticResource GridMessageLine}" />
                <DockPanel x:Name="StaleBar" DockPanel.Dock="Top" Margin="6,2,6,4" LastChildFill="True"
                           Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,2" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                            Content="{Binding DataContext.Texts.ObjectsRefresh, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}" />
                    <TextBlock Text="{Binding StaleText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Warning}" />
                </DockPanel>
                <local:ObjectEditorView />
            </DockPanel>
        </DataTemplate>

        <!-- A text: the notice (only when the text was cut) in the colour of a warning, then the text without wrapping. -->
        <DataTemplate DataType="{x:Type local:TextTabViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Header}" Margin="6,4" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}" Margin="6,0,6,4" TextWrapping="Wrap"
                           Foreground="{DynamicResource Theme.Warning}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </DataTemplate>

        <!-- A hint: heading, reason, then label and value per line. The values are read-only boxes so that they can be selected and copied. -->
        <DataTemplate DataType="{x:Type local:InfoTabViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding Lines}" Grid.IsSharedSizeScope="True" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:InfoLine}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Margin="0,0,16,0" VerticalAlignment="Top" Padding="0,1"
                                               Foreground="{DynamicResource Theme.TextMuted}" />
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                             Background="Transparent" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl x:Name="TabHost" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                MouseDown="OnTabControlMouseDown" PreviewMouseLeftButtonDown="OnTabControlPreviewMouseDown"
                PreviewKeyDown="OnTabControlPreviewKeyDown" SelectionChanged="OnTabControlSelectionChanged">
        <!--
            The header of a tab: the mark of unsaved changes (a dot in the colour of the text), the mark of an outdated tab (the colour of a
            warning), the title and the close button. The two marks are independent. Only an editable tab can be modified.
        -->
        <TabControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:TabViewModel}">
                <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding ToolTip}">
                    <Ellipse x:Name="ModifiedMark" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource Theme.Text}"
                             ToolTip="{Binding DataContext.Texts.TabModified, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}"
                             Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" />
                    <Ellipse x:Name="StaleMark" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource Theme.Warning}"
                             ToolTip="{Binding StaleText}"
                             Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    <Button Command="{Binding CloseCommand}" Margin="8,0,0,0" Padding="3" BorderThickness="0" Background="Transparent"
                            Focusable="False" VerticalAlignment="Center"
                            ToolTip="{Binding DataContext.Texts.TabClose, RelativeSource={RelativeSource AncestorType={x:Type local:TabsView}}}">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{DynamicResource Theme.Text}" StrokeThickness="1.5" />
                    </Button>
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>
    </TabControl>
</UserControl>
