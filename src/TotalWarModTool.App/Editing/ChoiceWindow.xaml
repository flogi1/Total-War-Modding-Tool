<Window x:Class="TotalWarModTool.App.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" MinWidth="360" MaxHeight="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.Text}">
    <!-- A question with a message, a list of lines (hidden when empty) and two or three buttons. The code-behind creates the buttons from their texts. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
            <ItemsControl x:Name="LinesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="12,0,0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="ButtonsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" />
    </Grid>
</Window>
