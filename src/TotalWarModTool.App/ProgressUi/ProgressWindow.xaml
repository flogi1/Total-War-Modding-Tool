<Window x:Class="TotalWarModTool.App.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.Text}">
    <!-- DataContext is the AppTexts instance; the title text is set in code because it is the name of the running operation, not a UI text. -->
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" IsIndeterminate="True" />
        <Grid Margin="0,6,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ItemBlock" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CountBlock" Grid.Column="1" Margin="12,0,0,0" />
        </Grid>
        <Button x:Name="CancelButton" Content="{Binding ProgressCancel}" HorizontalAlignment="Right" MinWidth="80" Padding="12,3"
                Click="OnCancelClick" />
    </StackPanel>
</Window>
