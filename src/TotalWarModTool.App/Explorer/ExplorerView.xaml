<UserControl x:Class="TotalWarModTool.App.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TotalWarModTool.App">
    <!--
        DataContext is the ExplorerViewModel. The tree is virtualized (also its nested levels): a folder can hold tens of thousands of entries.
        Virtualization needs ScrollViewer.CanContentScroll=True on the tree; the TreeView template of Themes/Controls.xaml honours it.
        The container style sits on top of the themed TreeViewItem style of the app: the code-behind sets its BasedOn (see ApplyThemedItemStyle).
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="NodeContainerStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <!-- MouseDoubleClick is a direct event: it does not bubble to the tree, so every item listens itself. -->
            <EventSetter Event="MouseDoubleClick" Handler="OnItemMouseDoubleClick" />
        </Style>

        <!-- One template for every node: the mark of a problem (the colour of a warning) and the name. -->
        <HierarchicalDataTemplate DataType="{x:Type local:ExplorerNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding ToolTip}">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource Theme.Warning}"
                         Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- The placeholder only makes its parent expandable and shows nothing. -->
        <DataTemplate DataType="{x:Type local:PlaceholderNode}">
            <Border />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <TreeView x:Name="Tree" ItemsSource="{Binding Groups}" ItemContainerStyle="{StaticResource NodeContainerStyle}"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                  Visibility="{Binding ShowTree, Converter={StaticResource BoolToVisibility}}"
                  KeyDown="OnTreeKeyDown" />

        <StackPanel Margin="12" VerticalAlignment="Top">
            <TextBlock x:Name="MessageBlock" Text="{Binding Message}" TextWrapping="Wrap"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
            <Button x:Name="OpenSettingsButton" Content="{Binding Texts.ExplorerOpenSettings}" Command="{Binding OpenSettingsCommand}"
                    HorizontalAlignment="Left" Margin="0,12,0,0"
                    Visibility="{Binding ShowOpenSettings, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
