<Window x:Class="TotalWarModTool.App.NewTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Width="520" Height="560" MinWidth="380" MinHeight="420" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.Text}"
        ContentRendered="OnContentRendered">
    <!--
        DataContext is the NewTableViewModel; the title is set in code (it is given by the caller). The window has a fixed size with the list
        in the one row that grows: the list holds over 1,500 table names and only shows what fits, which needs a bounded height and the
        virtualizing panel of the list box (so it is neither wrapped in a ScrollViewer nor in a panel that gives it unlimited height).
        The boxes update the view model on every keystroke. OK is the default button and is disabled while the validation has a text.
    -->
    <Window.Resources>
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Warning}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16" FocusManager.FocusedElement="{Binding ElementName=FilterBox}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="FilterLabel" Grid.Row="0" Text="{Binding Texts.FileTableFilterLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="FilterBox" Grid.Row="1" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                 automation:AutomationProperties.LabeledBy="{Binding ElementName=FilterLabel}"
                 PreviewKeyDown="OnFilterKeyDown" />

        <TextBlock x:Name="TableLabel" Grid.Row="2" Text="{Binding Texts.FileTableListLabel}" Margin="0,0,0,4" />
        <ListBox x:Name="TableList" Grid.Row="3" Margin="0,0,0,12" SelectionMode="Single"
                 ItemsSource="{Binding FilteredTables}" SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                 automation:AutomationProperties.LabeledBy="{Binding ElementName=TableLabel}"
                 PreviewKeyDown="OnListKeyDown" SelectionChanged="OnSelectionChanged" />

        <TextBlock x:Name="NameLabel" Grid.Row="4" Text="{Binding Texts.DialogName}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Grid.Row="5" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                 automation:AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}" />

        <TextBlock x:Name="ErrorText" Grid.Row="6" Text="{Binding Error}" Style="{StaticResource ErrorTextStyle}" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="OkButton" Content="{Binding Texts.DialogOk}" MinWidth="90" Padding="12,3" IsDefault="True"
                    IsEnabled="{Binding CanAccept}" Click="OnOkClick" />
            <Button x:Name="CancelButton" Content="{Binding Texts.DialogCancel}" MinWidth="90" Padding="12,3" Margin="8,0,0,0" IsCancel="True"
                    Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
