<UserControl x:Class="TotalWarModTool.App.ObjectBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        DataContext is the ObjectTabViewModel. The document is read-only and can be selected and copied; the code-behind fills it from Lines,
        one paragraph per line and one run per span. The colours of the spans are resource references to the tokens of the theme.
    -->
    <FlowDocumentScrollViewer x:Name="Viewer" IsSelectionEnabled="True" IsToolBarVisible="False"
                              VerticalScrollBarVisibility="Auto"
                              SelectionBrush="{DynamicResource Theme.Selection}">
        <FlowDocument x:Name="Document" FontFamily="Consolas" PagePadding="8" TextAlignment="Left"
                      Background="{DynamicResource Theme.PanelBackground}" Foreground="{DynamicResource Theme.Text}" />
    </FlowDocumentScrollViewer>
</UserControl>
