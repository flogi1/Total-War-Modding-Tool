<UserControl x:Class="TotalWarModTool.App.ObjectEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit">
    <!--
        DataContext is the ObjectTabViewModel. The editor shows its Text; the code-behind only wires the text in both directions, the read-only
        head line and the keys. The colours are resource references to the tokens of the theme. Ctrl+Enter applies; Ctrl+Z and Ctrl+Y are not
        handled here (the window binds them to the global history).
    -->
    <avalon:TextEditor x:Name="TextBox" FontFamily="Consolas" ShowLineNumbers="False" WordWrap="False"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                       Background="{DynamicResource Theme.PanelBackground}" Foreground="{DynamicResource Theme.Text}">
        <avalon:TextEditor.InputBindings>
            <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding ApplyCommand}" />
        </avalon:TextEditor.InputBindings>
    </avalon:TextEditor>
</UserControl>
